Bootstrap: docker
From: alpine:3.20

# Apptainer translation of docker/Dockerfile.cascade for S3DF (no Docker).
# Builds the STANDALONE achilles-cascade binary (pi/p/n-nucleus CrossSection driver) with the
# interaction-registry fix. Single-stage (keeps the build toolchain in the image; simpler than the
# Dockerfile's multi-stage slim, and disk is cheap on the data area).
# Build context = the fork checkout at commit 7054913f, passed via %files.
#   apptainer build --fakeroot cascade.sif docker/cascade.def   (run FROM the fork-source dir OR with abs path)

%files
    /sdf/data/neutrino/cjesus/ADoNIS/software/Achilles-src /achilles_src

%post
    set -e
    apk update && apk add g++ gcc musl-dev cmake hdf5-dev make git gfortran python3

    # --- interaction-registry fix (identical to Dockerfile.cascade) --------------------------------
    python3 - <<'PYEOF'
cm = "/achilles_src/src/Achilles/CMakeLists.txt"
s = open(cm).read()
s = s.replace("PUBLIC event_gen docopt::docopt cmake_git_version_tracking)",
              "PUBLIC event_gen docopt::docopt cmake_git_version_tracking dl plugin_manager AchillesCascadeInteractions)")
s = s.replace("    list(APPEND achilles_targets achilles-cascade)",
              "    target_link_options(achilles-cascade PRIVATE \"LINKER:--no-as-needed\")\n    list(APPEND achilles_targets achilles-cascade)")
open(cm, "w").write(s)
assert 'target_link_options(achilles-cascade' in open(cm).read()
mn = "/achilles_src/src/Achilles/CascadeMain.cc"
s = open(mn).read()
s = s.replace('#include "Achilles/Version.hh"',
              '#include "Achilles/Version.hh"\n#include "Plugins/Manager/PluginManager.hh"')
s = s.replace("    achilles::CascadeTest::RunCascade(runcard);",
              "    achilles::Plugin::Manager plugin_manager;\n    achilles::CascadeTest::RunCascade(runcard);")
open(mn, "w").write(s)
assert "plugin_manager)" in open(cm).read() and "Plugin::Manager plugin_manager;" in open(mn).read()
print("patched CMakeLists + CascadeMain")
PYEOF

    cmake -S achilles_src -B achilles \
        -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
        -DACHILLES_ENABLE_CASCADE_TEST=ON \
        -DCMAKE_CXX_FLAGS="-fno-visibility-inlines-hidden"
    cmake --build achilles -j

%runscript
    cd /achilles && exec ./bin/achilles "$@"

%labels
    org.adonis.role achilles-cascade (standalone pi/p/n-nucleus CrossSection driver)
    org.adonis.source Achilles-adonis @ 7054913f
