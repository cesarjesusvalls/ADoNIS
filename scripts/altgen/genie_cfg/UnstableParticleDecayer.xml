<?xml version="1.0" encoding="ISO-8859-1"?>
<!-- ADoNIS/Callum_C override: drop PythiaDecayer (Decayer-0) because PYTHIA6
     raises an illegal instruction under Docker Rosetta amd64 emulation on this
     Apple-Silicon host. At T2K RES energies the resonance decay N* -> N pi is
     handled entirely by BaryonResonanceDecayer; PYTHIA6 is only needed for rare
     eta/rho/omega decays, whose absence is documented and negligible for the
     CC0pi/CC1pi STV selections. This keeps generation on fast Rosetta. -->
<alg_conf>

  <param_set name="BeforeHadronTransport">
     <param type="int" name="NDecayers">  1                                                    </param>
     <param type="alg" name="Decayer-0">  genie::BaryonResonanceDecayer/BeforeHadronTransport  </param>
  </param_set>

  <param_set name="AfterHadronTransport">
     <param type="int" name="NDecayers">  1                                                    </param>
     <param type="alg" name="Decayer-0">  genie::BaryonResonanceDecayer/AfterHadronTransport   </param>
  </param_set>

  <param_set name="DarkSector">
     <param type="int" name="NDecayers">  2                                                    </param>
     <param type="alg" name="Decayer-0">  genie::BaryonResonanceDecayer/AfterHadronTransport   </param>
     <param type="alg" name="Decayer-1">  genie::DarkSectorDecayer/Default </param>
  </param_set>

</alg_conf>
