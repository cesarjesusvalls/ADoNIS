# JAX / OS
.DS_Store
.jax_cache/

# Run products, all regenerable: figures, banks and caches, ACHILLES events, logs.
*.png
*.npz
*.hepmc
*.log
*_out.txt

# Inputs and outputs live outside the repo; see analysis/paper/REPRODUCE.md.  Both spellings are
# needed: `data/` and `output/` match a directory only, and in a working checkout these are usually
# symlinks, which the trailing-slash form does not match.
data
data/
output
output/
_paper_release/

# local working rules, not part of the repo
CLAUDE.md

# container images and rendered batch scripts, which pick up site paths
*.sif
jobs/generated/

# credentials, none of which belong in a public repo
.env
*.pem
*.key
id_rsa*
.netrc
